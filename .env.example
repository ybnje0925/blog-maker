# Shared server API keys for free daily generation.
# Leave a provider key empty to disable that provider's free server API.
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Optional model overrides.
OPENAI_MODEL="gpt-4.1-mini"
GEMINI_MODEL="gemini-2.5-flash"

# Public base URL used for canonical, robots, and sitemap generation.
BASE_URL="http://localhost:3222"
