# Server API key for generation.
GEMINI_API_KEY=""

# Optional model override.
GEMINI_MODEL="gemini-2.5-flash"

# Public base URL used for canonical, robots, and sitemap generation.
VITE_SITE_URL="http://localhost:3222"

# Optional analytics. Loaded only in production builds when values are set.
VITE_GA_MEASUREMENT_ID=""
VITE_CLARITY_PROJECT_ID=""
VITE_SHOW_AD_PLACEHOLDERS="false"

# Public policy/contact display values.
VITE_CONTACT_EMAIL=""
VITE_OPERATOR_NAME=""
